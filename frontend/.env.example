# Backend API
EXPO_PUBLIC_API_URL=http://localhost:8000

# Firebase config (from Firebase Console > Project Settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client IDs (from Google Cloud Console > APIs & Services > Credentials)
# iOS Client ID: create an "iOS" OAuth client, bundle ID = com.nearish.mobile
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web Client ID: the auto-created "Web client (auto created by Google Service)" OAuth client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
